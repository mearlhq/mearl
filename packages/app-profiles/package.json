{
  "name": "@mearl/app-profiles",
  "version": "3.0.0",
  "description": "Declarative App profile compilation for installed capabilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "files": [
    "README.en.md",
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "mearl"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@mearl/browser-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mearlhq/mearl.git",
    "directory": "packages/app-profiles"
  }
}
