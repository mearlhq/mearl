---
import { ArrowRight, Braces, Cable, Globe, Network, ScanSearch, Smartphone } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath, type Locale, type Page } from '../lib/site';
import { siteCopy } from '../lib/site-copy';
import '../styles/home.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = siteCopy[locale];
const capabilities: Array<{
  key: keyof typeof t.capabilityGroups;
  Icon: typeof Globe;
  page: Page;
  label: string;
  anchor?: string;
}> = [
  { key: 'automate', Icon: Globe, page: 'browser-automation', label: t.automation },
  { key: 'debug', Icon: ScanSearch, page: 'web-debugging', label: t.debugging },
  { key: 'request', Icon: Network, page: 'authenticated-requests', label: t.authenticatedRequests },
  { key: 'emulate', Icon: Smartphone, page: 'emulation', label: t.mobileGuide, anchor: '#device' },
  { key: 'reuse', Icon: Braces, page: 'skill-plugins', label: t.reuseGuide, anchor: '#reuse-workflow' },
  { key: 'connect', Icon: Cable, page: 'browsers', label: t.connections },
];
---
<BaseLayout title={`Mearl · ${t.headline}`} description={t.heroLead} {locale} page="home">
  <div class="product-home docs-article">
    <section class="product-hero" aria-labelledby="hero-title">
      <p class="product-license">{t.openSource}</p>
      <h1 id="hero-title">{t.headline}</h1>
      <p class="product-lead">{t.heroLead}</p>
      <div class="product-actions">
        <a class="button button-primary" href={sitePath(locale, 'installation')}>{t.installTitle}<ArrowRight size={16} aria-hidden="true" /></a>
        <a class="button button-secondary" href={sitePath(locale, 'introduction')}>{t.documentation}</a>
      </div>
    </section>

    <section class="product-section" id="capabilities" aria-labelledby="capabilities-title">
      <h2 id="capabilities-title">{t.capabilityOverview}</h2>
      <ul class="product-capabilities" role="list">
        {capabilities.map(({ key, Icon, page, label, anchor = '' }) => {
          const { title, text } = t.capabilityGroups[key];
          return (
            <li>
              <div class="product-capability-icon"><Icon size={20} aria-hidden="true" /></div>
              <h3>{title}</h3>
              <p>{text}</p>
              <a href={sitePath(locale, page) + anchor}>{label}<ArrowRight size={14} aria-hidden="true" /></a>
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</BaseLayout>
