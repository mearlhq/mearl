---
import { ArrowRight, ArrowUpRight, Braces, Check, Globe, ScanSearch, Smartphone, FileSpreadsheet, Terminal } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from './CodeBlock.astro';
import GitHubIcon from './GitHubIcon.astro';
import { repositoryUrl, setupCommand, sitePath, type Guide, type Locale } from '../lib/site';
import { screenshots } from '../lib/screenshots';
import { siteCopy } from '../lib/site-copy';
import '../styles/home.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = siteCopy[locale];
const capabilityIcons = [Globe, ScanSearch, Smartphone, Braces];
const useCaseLinks = [
  sitePath(locale, 'emulation') + '#verify',
  sitePath(locale, 'web-debugging') + '#trace',
  sitePath(locale, 'skill-plugins') + '#design-review',
  sitePath(locale, 'skill-plugins') + '#reuse-workflow',
];
const capabilityLinks: Array<Array<{ page: Guide; label: string; anchor?: string }>> = [
  [
    { page: 'browser-automation', label: t.automation },
    { page: 'authenticated-requests', label: t.authenticatedRequests },
    { page: 'ego-lite', label: 'EgoLite' },
  ],
  [
    { page: 'web-debugging', label: t.debugging },
  ],
  [
    { page: 'emulation', label: t.mobileGuide, anchor: '#app' },
    { page: 'emulation', label: t.miniProgramGuide, anchor: '#wechat-miniprogram' },
  ],
  [
    { page: 'skill-plugins', label: t.reuseGuide, anchor: '#reuse-workflow' },
    { page: 'bb-browser', label: t.bbAdapters },
  ],
];
const comparison = [
  {
    ...screenshots.appBrowser,
    label: t.comparisonBrowser, caption: screenshots.appBrowser[locale],
  },
  {
    ...screenshots.appWebView,
    label: t.comparisonApp, caption: screenshots.appWebView[locale],
  },
] as const;
---
<BaseLayout title={`Mearl · ${t.tagline}`} description={t.heroLead} {locale} page="home">
  <div class="product-home docs-article">
    <section class="product-hero" aria-labelledby="hero-title">
      <div class="product-hero-intro">
        <span class="product-license">{t.positioning}</span>
        <h1 id="hero-title">{t.headline[0]}<span>{t.headline[1]}</span></h1>
        <p>{t.heroLead}</p>
        <div class="product-actions">
          <a class="button button-primary" href={sitePath(locale, 'installation')}>{t.homeInstall}<ArrowRight size={15} aria-hidden="true" /></a>
          <a class="button button-secondary" href={repositoryUrl}><GitHubIcon />GitHub</a>
        </div>
        <p class="product-connection-note">{t.connectionLead}</p>
      </div>

      <section class="product-demo" id="case" aria-labelledby="case-title">
        <div class="product-demo-stage">
          <div class="product-demo-title">
            <h2 id="case-title">{t.demoTitle}</h2>
            <span class="demo-preview-label">{t.casePreview}</span>
          </div>
          <fieldset class="demo-switcher">
            <legend class="demo-sr-only">{t.demoTitle}</legend>
            {t.demoTabs.map((label, index) => <label>
              <input type="radio" name="demo-stage" value={index} checked={index === 1} />
              <span><b>0{index + 1}</b>{label}</span>
            </label>)}
          </fieldset>
          <div class="demo-task"><Terminal size={16} aria-hidden="true" /><p>{t.casePrompt}</p></div>
          <div class="demo-scenes">
            {t.demoScenes.map((scene, index) => (
              <div class="demo-scene" data-scene={index}>
                <div class="demo-browser">
                  <div class="demo-page-content">
                    <span class="demo-page-title"><Globe size={14} aria-hidden="true" />{t.demoPage}</span>
                    <div class="demo-report"><span class="demo-report-icon"><FileSpreadsheet size={24} stroke-width={1.5} aria-hidden="true" /></span><div><strong>{t.demoItem}</strong><small>{t.demoItemDetail}</small></div></div>
                    <div class="demo-artifact"><FileSpreadsheet size={14} aria-hidden="true" /><span>{scene.artifact}</span></div>
                    <div class:list={['demo-feedback', { 'is-success': index > 0 }]}>
                      <Check size={14} aria-hidden="true" />{scene.status}
                    </div>
                  </div>
                </div>
                <div class="demo-inspector">
                  <span class="demo-inspector-label">{scene.label}</span>
                  <h3>{scene.heading}</h3>
                  <p>{scene.detail}</p>
                  <pre><code>{scene.lines.join('\n')}</code></pre>
                  <div class="demo-result"><span class="demo-result-dot"></span>{scene.result}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="product-demo-note">
          <span>{t.openSource}</span>
          <a href={sitePath(locale, 'browser-automation')}>{t.automation}<ArrowUpRight size={15} aria-hidden="true" /></a>
        </div>
      </section>
    </section>

    <section class="product-section" id="capabilities">
      <span class="product-kicker">{t.overview}</span>
      <h2>{t.capabilityOverview}</h2>
      <ul class="product-capabilities" role="list">
        {t.capabilityGroups.map(({ title, text }, index) => {
          const Icon = capabilityIcons[index];
          return (
            <li>
              <div class="product-capability-icon"><Icon size={20} aria-hidden="true" /></div>
              <h3>{title}</h3>
              <p>{text}</p>
              <div class="product-links">
                {capabilityLinks[index].map(({ page, label, anchor = '' }) => (
                  <a href={sitePath(locale, page) + anchor}>{label}<ArrowRight size={14} aria-hidden="true" /></a>
                ))}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="product-section product-comparison" id="app-comparison" aria-labelledby="comparison-title">
      <div class="product-comparison-copy">
        <span class="product-kicker"><Smartphone size={15} aria-hidden="true" />{t.emulation}</span>
        <h2 id="comparison-title">{t.comparisonTitle}<span>{t.comparisonTitleEnd}</span></h2>
        <p>{t.comparisonLead}</p>
        <ul class="product-emulation-features">
          {t.comparisonFeatures.map(({ title, text }) => <li><strong>{title}</strong><span>{text}</span></li>)}
        </ul>
        <div class="product-comparison-links">
          <a href={sitePath(locale, 'emulation') + '#app'}>{t.mobileGuide}<ArrowRight size={15} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="product-comparison-stage">
        <p class="product-comparison-example">{t.comparisonExample}</p>
        <div class="product-comparison-grid">
          {comparison.map(({ url: src, label, caption, width, height }) => (
            <figure class="product-comparison-view">
              <h3>{label}</h3>
              <a href={src} aria-label={caption}>
                <img {src} {width} {height} alt="" loading="lazy" decoding="async" />
              </a>
              <figcaption>{caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="product-section" id="workflow">
      <h2>{t.useCasesTitle}</h2>
      <div class="product-role-links">
        {t.useCases.map(({ title, text }, index) => (
          <a href={useCaseLinks[index]}>
            <strong>{title}<ArrowRight size={16} aria-hidden="true" /></strong>
            <span>{text}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="product-section product-start" id="start">
      <div>
        <span class="product-kicker">{t.gettingStarted}</span>
        <h2>{t.homeInstall}</h2>
        <p>{t.startInstall}</p>
        <div class="product-actions">
          <a class="button button-primary" id="installation" href={sitePath(locale, 'installation')}>{t.install}<ArrowRight size={15} aria-hidden="true" /></a>
          <a class="button button-secondary" id="quick-start" href={sitePath(locale, 'quick-start')}>{t.quickstart}</a>
        </div>
      </div>
      <CodeBlock {locale} id="home-install-command" label={t.agentInstall} command={setupCommand} />
    </section>
  </div>
</BaseLayout>
