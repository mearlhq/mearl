---
import { sitePath, type Locale, type Page } from '../lib/site';

interface Props { locale: Locale }
interface Entry { title: string; text: string; page: Page; anchor?: string }
interface Overview {
  inputTitle: string;
  inputs: Entry[];
  hubText: string;
  actions: Array<{ title: string; page: Page }>;
  connectionTitle: string;
  connections: Entry[];
  notes: { title: string; lead: string; entries: Entry[] };
}

const { locale } = Astro.props;
const copy: Record<Locale, Overview> = {
  'zh-CN': {
    inputTitle: '谁发起操作',
    inputs: [
      { title: 'Agent', text: '按 Mearl Skill 的指引调用 CLI，或使用 MCP 工具。', page: 'quick-start' },
      { title: '终端或应用', text: '通过 CLI 或 TypeScript SDK 直接调用。', page: 'reference/cli-sdk' },
    ],
    hubText: '把操作交给选定的浏览器。多步任务可使用控制会话保持目标一致，需要时交给人操作。',
    actions: [
      { title: '网页操作', page: 'browser-automation' },
      { title: '请求与日志', page: 'web-debugging' },
      { title: '设备与 App 模拟', page: 'emulation' },
    ],
    connectionTitle: '如何接入浏览器',
    connections: [
      { title: '通过 Chrome 扩展接入', text: '开启 Agent 服务后，可使用该浏览器配置里的标签页和登录态。', page: 'installation', anchor: '#installation' },
      { title: '直连 CDP', text: '接入已开放远程调试的浏览器或 Electron 页面，也可启动独立 Chrome。', page: 'browsers', anchor: '#connections' },
      { title: '由 Provider 接入', text: '连接外部浏览器或设备。可用动作取决于所选 Provider。', page: 'reference/providers' },
    ],
    notes: {
      title: '接入与扩展',
      lead: 'Mearl 支持从云端发起操作，也提供浏览器内的工具。常用流程可以复用，网页运行环境可以按目标 App 配置。',
      entries: [
        { title: '云端调用', text: '云端请求由 Cloud Server 中转，再经 Connector 到达浏览器所在主机。', page: 'browsers', anchor: '#connections' },
        { title: '扩展界面', text: '安装扩展后，可在浏览器内打开工具箱、Agent 对话和 DevTools 面板。', page: 'extension' },
        { title: 'Skill', text: '为 Agent 提供任务指引，也可附带可执行命令或工具箱界面。', page: 'skill-plugins' },
        { title: 'App Profile', text: '给支持的浏览器提供 App 身份、JSBridge 和容器模拟配置。', page: 'reference/app-profiles' },
      ],
    },
  },
  en: {
    inputTitle: 'Who calls Mearl',
    inputs: [
      { title: 'Agent', text: 'Follow the Mearl Skill to use the CLI, or call MCP tools.', page: 'quick-start' },
      { title: 'Terminal or application', text: 'Call the CLI or TypeScript SDK directly.', page: 'reference/cli-sdk' },
    ],
    hubText: 'Route actions to the target browser. A control session keeps tasks on the same target and supports handing control to a person.',
    actions: [
      { title: 'Page actions', page: 'browser-automation' },
      { title: 'Requests and logs', page: 'web-debugging' },
      { title: 'Device and App emulation', page: 'emulation' },
    ],
    connectionTitle: 'How Mearl connects',
    connections: [
      { title: 'Chrome extension', text: 'Enable Agent Service to use the tabs and sign-in in that Chrome profile.', page: 'installation', anchor: '#installation' },
      { title: 'Direct CDP', text: 'Connect to a browser or Electron page with remote debugging enabled, or launch a separate Chrome instance.', page: 'browsers', anchor: '#connections' },
      { title: 'Provider', text: 'Connect to an external browser or device. Supported actions depend on the selected Provider.', page: 'reference/providers' },
    ],
    notes: {
      title: 'Connect and extend Mearl',
      lead: 'Mearl supports cloud calls and tools in the browser. You can reuse common workflows and configure the web environment to match a target app.',
      entries: [
        { title: 'Cloud access', text: 'Cloud Server relays requests through a Connector on the host that runs the browser.', page: 'browsers', anchor: '#connections' },
        { title: 'Extension interfaces', text: 'Install the extension to use the Toolbox, Agent Chat, and DevTools panel in the browser.', page: 'extension' },
        { title: 'Skill', text: 'Give agents task instructions and optionally include commands or a Toolbox interface.', page: 'skill-plugins' },
        { title: 'App Profile', text: 'Configure App identity, JSBridge, and container behavior in a supported browser.', page: 'reference/app-profiles' },
      ],
    },
  },
};
const { inputTitle, inputs, hubText, actions, connectionTitle, connections, notes } = copy[locale];
---
<div class="capability-map">
  <div class="map-path">
    <div class="map-side">
      <h3>{inputTitle}</h3>
      <ul class="map-entries" role="list">
        {inputs.map(({ title, text, page }) => (
          <li><a href={sitePath(locale, page)}>{title}</a><span>{text}</span></li>
        ))}
      </ul>
    </div>
    <span class="map-arrow" aria-hidden="true"></span>
    <div class="map-hub">
      <h3>Mearl</h3>
      <p>{hubText}</p>
      <ul class="map-actions" role="list">
        {actions.map(({ title, page }) => <li><a href={sitePath(locale, page)}>{title}</a></li>)}
      </ul>
    </div>
    <span class="map-arrow" aria-hidden="true"></span>
    <div class="map-side">
      <h3>{connectionTitle}</h3>
      <ul class="map-entries" role="list">
        {connections.map(({ title, text, page, anchor = '' }) => (
          <li><a href={sitePath(locale, page) + anchor}>{title}</a><span>{text}</span></li>
        ))}
      </ul>
    </div>
  </div>
  <section class="map-notes-section" aria-labelledby="map-notes-title">
    <h3 id="map-notes-title">{notes.title}</h3>
    <p>{notes.lead}</p>
    <dl class="map-notes">
      {notes.entries.map(({ title, text, page, anchor = '' }) => (
        <div><dt><a href={sitePath(locale, page) + anchor}>{title}</a></dt><dd>{text}</dd></div>
      ))}
    </dl>
  </section>
</div>

<style>
  .capability-map { container-type: inline-size; margin: 20px 0 0; }
  .map-path {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1.08fr) 26px minmax(0, 1.2fr);
    align-items: center;
    padding: clamp(12px, 2.7cqw, 22px);
    border: 1px solid var(--docs-border);
    border-radius: 12px;
    background: var(--docs-panel);
  }
  .map-side h3 { margin: 0 0 8px; color: var(--muted); font-size: 13px; }
  .map-entries, .map-actions { display: grid; gap: 6px; padding: 0; margin: 0; list-style: none; }
  .map-entries li {
    display: grid;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid var(--docs-border);
    border-radius: 6px;
    background: var(--docs-canvas);
  }
  .map-entries a, .map-notes dt { font-size: 14px; font-weight: 650; }
  .map-entries span, .map-hub p, .map-notes dd { color: var(--muted); font-size: 13px; line-height: 1.55; }
  .map-hub {
    padding: 14px;
    border: 1px solid var(--accent-border);
    border-radius: 8px;
    background: var(--docs-accent-surface);
  }
  .map-hub h3 { margin: 0; color: var(--docs-title); font-size: 22px; line-height: 1.3; }
  .map-hub p { margin: 6px 0 12px; }
  .map-actions { display: flex; flex-wrap: wrap; }
  .map-actions a { display: inline-block; padding: 3px 7px; border: 1px solid var(--docs-border); border-radius: 4px; background: var(--docs-canvas); font-size: 12px; }
  .map-arrow { position: relative; display: block; height: 1px; margin: 0 5px; background: var(--blue); }
  .map-arrow::after { content: ''; position: absolute; inset-inline-end: 0; top: -3px; width: 6px; height: 6px; border-block-start: 1px solid var(--blue); border-inline-end: 1px solid var(--blue); transform: rotate(45deg); }
  .map-notes-section { margin-top: 24px; }
  .map-notes-section h3 { margin: 0 0 6px; color: var(--docs-title); font-size: clamp(19px, 3cqw, 23px); line-height: 1.35; }
  .map-notes-section > p { margin: 0; color: var(--muted); line-height: 1.65; }
  .map-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 20px; margin: 8px 0 0; }
  .map-notes > div { padding-top: 8px; }
  .map-notes > div:nth-child(n+3) { border-top: 1px solid var(--docs-border); }
  .map-notes dd { margin: 2px 0 0; }
  @container (max-width: 630px) {
    .map-path { grid-template-columns: minmax(0, 1fr); padding: 12px; }
    .map-arrow { width: 16px; margin: 11px auto; transform: rotate(90deg); }
    .map-hub { padding: 12px; }
  }
  @container (max-width: 420px) {
    .map-notes { grid-template-columns: minmax(0, 1fr); }
    .map-notes > div + div { border-top: 1px solid var(--docs-border); }
  }
</style>
