---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import ArchitectureFlow from './ArchitectureFlow.astro';
import CodeBlock from './CodeBlock.astro';
import ExtensionInstallLinks from './ExtensionInstallLinks.astro';
import ProductCapabilityMap from './ProductCapabilityMap.astro';
import ProductScreenshot from './ProductScreenshot.astro';
import QuickStart from './QuickStart.astro';
import { guideContent } from '../lib/guides';
import { docPath, repositoryUrl, setupCommand, sitePath, type Guide, type Locale } from '../lib/site';
import { siteCopy } from '../lib/site-copy';

interface Props { locale: Locale; page: Guide }
const { locale, page } = Astro.props;
const t = siteCopy[locale];
const install = page === 'installation';
const quick = page === 'quick-start';
const category = install || quick || page === 'introduction' ? t.gettingStarted
  : page === 'skill-plugins' ? t.reference : t.workflows;
const guide = install || quick ? undefined : guideContent[page][locale];
const title = guide?.title ?? (install ? t.installTitle : t.quickTitle);
const description = guide?.lead ?? (install ? t.installSummary : t.quickSummary);
const topics = guide?.sections.map(section => ({ id: section.id, label: section.title })) ?? (install ? [
  { id: 'agent', label: t.agentInstall },
  { id: 'browsers', label: t.browserInstall },
  { id: 'installation', label: t.installExtension },
  { id: 'verify', label: t.verifySetup },
  { id: 'mcp', label: t.installMcp },
] : [
  { id: 'quick-start', label: t.quickRun },
  { id: 'existing-tab', label: t.quickExisting },
  { id: 'next', label: t.nextSteps },
  { id: 'connect', label: t.quickTroubleshoot },
]);
---
<DocsLayout title={`${title} · Mearl`} {description} {locale} {page} {topics}>
  <header class="docs-detail">
    <p class="docs-eyebrow"><span></span>{category}</p>
    <h1>{title}</h1>
    <p class="docs-lead">{description}</p>
    {install && <div class="docs-guide-links">
      <a href="#agent">{t.agentInstall}<ArrowRight size={14} aria-hidden="true" /></a>
      <a href="#browsers">{t.browserInstall}<ArrowRight size={14} aria-hidden="true" /></a>
    </div>}
    {quick && <div class="docs-guide-links"><a href={sitePath(locale, 'installation')}>{t.setupGuide}<ArrowRight size={14} aria-hidden="true" /></a></div>}
  </header>

  {guide?.routes && <div class="docs-topic-grid docs-task-grid">
    {guide.routes.map(({ id, title, text }) => (
      <a href={`#${id}`}><strong>{title}<ArrowRight size={15} aria-hidden="true" /></strong><span>{text}</span></a>
    ))}
  </div>}

  {guide?.sections.map(section => (
    <section class="docs-section" id={section.id}>
      <div class="docs-section-heading">
        <h2>{section.title}</h2>
        {section.links && <div class="docs-guide-links">
          {section.links.map(link => {
            const href = 'url' in link ? link.url : 'page' in link ? sitePath(locale, link.page)
              : link.shared ? `${repositoryUrl}/blob/main/${link.path}` : docPath(locale, link.path);
            const Icon = href.startsWith('/') ? ArrowRight : ArrowUpRight;
            return <a href={href}>{link.label}<Icon size={14} aria-hidden="true" /></a>;
          })}
        </div>}
      </div>
      {(Array.isArray(section.text) ? section.text : [section.text]).map(text => <p>{text}</p>)}
      {page === 'introduction' && section.id === 'capabilities' && <ProductCapabilityMap {locale} />}
      {section.items && <ul class="docs-guide-list">{section.items.map(item => <li>{item}</li>)}</ul>}
      {section.flow && <ArchitectureFlow flow={section.flow} />}
      {section.steps && <ol class="docs-guide-list">{section.steps.map(step => <li>{step}</li>)}</ol>}
      {section.command && <CodeBlock {locale} id={`${section.id}-command`} command={section.command} label="Shell" />}
      {Array.isArray(section.screenshot) ? (
        <div class="docs-figure-pair">
          {section.screenshot.map(screenshot => <ProductScreenshot {screenshot} {locale} />)}
        </div>
      ) : section.screenshot && <ProductScreenshot screenshot={section.screenshot} {locale} />}
    </section>
  ))}

  {install && (
    <>
      <section class="docs-section" id="agent">
        <div class="docs-section-heading">
          <h2>{t.agentInstall}</h2>
          <div class="docs-guide-links"><a href={docPath(locale, 'packages/setup/README.md')}>{t.setupGuide}<ArrowRight size={14} aria-hidden="true" /></a></div>
        </div>
        <p>{t.requirements}</p>
        <p>{t.installLead}</p>
        <CodeBlock {locale} id="install-command" command={setupCommand} label="Shell" />
      </section>
      <section class="docs-section" id="browsers">
        <div class="docs-section-heading">
          <h2>{t.browserInstall}</h2>
          <div class="docs-guide-links"><a href={sitePath(locale, 'browsers')}>{t.connections}<ArrowRight size={14} aria-hidden="true" /></a></div>
        </div>
        <p>{t.browserInstallLead}</p>
        <dl class="docs-connection-options">
          {t.browserOptions.map(({ title, text }) => <div><dt>{title}</dt><dd>{text}</dd></div>)}
        </dl>
        <section class="docs-install-option" id="installation">
          <div class="docs-section-heading">
            <h3>{t.installExtension}</h3>
            <div class="docs-guide-links"><a href={sitePath(locale, 'extension') + '#toolbox'}>{t.extensionTry}<ArrowRight size={14} aria-hidden="true" /></a></div>
          </div>
          <p>{t.extensionInstallLead}</p>
          <ExtensionInstallLinks {locale} />
        </section>
      </section>
      <section class="docs-section" id="verify">
        <div class="docs-section-heading">
          <h2>{t.verifySetup}</h2>
          <div class="docs-guide-links"><a href={sitePath(locale, 'quick-start')}>{t.continueToQuick}<ArrowRight size={14} aria-hidden="true" /></a></div>
        </div>
        <p>{t.verifySetupLead}</p>
        <CodeBlock {locale} id="check-command" command={'mearl check\nmearl browser_list'} label="Shell" />
        <p class="docs-follow-up">{t.verifyResult}</p>
      </section>
      <section class="docs-section" id="mcp">
        <div class="docs-section-heading">
          <h2>{t.installMcp}</h2>
          <div class="docs-guide-links"><a href={docPath(locale, 'packages/mcp-server/README.md')}>{t.mcp}<ArrowRight size={14} aria-hidden="true" /></a></div>
        </div>
        <p>{t.installMcpLead}</p>
        <CodeBlock {locale} id="mcp-command" command={`${setupCommand} --mcp`} label="Shell" />
      </section>
    </>
  )}

  {quick && (
    <>
      <section class="docs-section" id="quick-start">
        <h2>{t.quickRun}</h2>
        <QuickStart {locale} />
      </section>
      <section class="docs-section" id="existing-tab">
        <h2>{t.quickExisting}</h2>
        <p>{t.quickExistingLead}</p>
        <CodeBlock {locale} id="existing-tab-prompt" command={t.quickExistingPrompt} label={t.promptLabel} prompt />
        <p class="docs-follow-up">{t.quickExistingResult}</p>
      </section>
      <section class="docs-section" id="next">
        <h2>{t.nextSteps}</h2>
        <div class="docs-guide-links">
          <a href={sitePath(locale, 'browser-automation')}>{t.automation}<ArrowRight size={14} aria-hidden="true" /></a>
          <a href={sitePath(locale, 'web-debugging')}>{t.debugging}<ArrowRight size={14} aria-hidden="true" /></a>
          <a href={sitePath(locale, 'authenticated-requests')}>{t.authenticatedRequests}<ArrowRight size={14} aria-hidden="true" /></a>
          <a href={sitePath(locale, 'emulation')}>{t.emulation}<ArrowRight size={14} aria-hidden="true" /></a>
          <a href={sitePath(locale, 'reference/skills')}>{t.skills}<ArrowRight size={14} aria-hidden="true" /></a>
          <a href={sitePath(locale, 'skill-plugins') + '#reuse-workflow'}>{t.reuseGuide}<ArrowRight size={14} aria-hidden="true" /></a>
        </div>
        <p class="docs-follow-up">{t.quickNote} <a href={docPath(locale, 'packages/client/README.md')}>{t.cli}</a> · <a href={docPath(locale, 'packages/mcp-server/README.md')}>{t.mcp}</a></p>
      </section>
      <section class="docs-section" id="connect">
        <details class="docs-disclosure">
          <summary>{t.quickTroubleshoot}</summary>
          <p>{t.quickTroubleshootLead}</p>
          <CodeBlock {locale} id="quick-browser-list" command="mearl browser_list" label="Shell" />
          <div class="docs-guide-links">
            <a href={sitePath(locale, 'installation') + '#verify'}>{t.verifySetup}<ArrowRight size={14} aria-hidden="true" /></a>
            <a href={sitePath(locale, 'installation') + '#mcp'}>{t.installMcp}<ArrowRight size={14} aria-hidden="true" /></a>
          </div>
        </details>
      </section>
    </>
  )}
</DocsLayout>
