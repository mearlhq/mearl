---
import { ArrowRight, X } from '@lucide/astro';
import type { Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = locale === 'en'
  ? { message: 'Team setup guide available', visit: 'View guide', never: 'Don’t show again', close: 'Dismiss team setup notice' }
  : { message: '团队安装指引可用', visit: '查看指引', never: '不再提示', close: '关闭团队安装指引提示' };
---
<aside class="custom-website-banner" data-custom-website-banner aria-label={t.message} hidden>
  <div class="custom-website-banner-content">
    <span>{t.message}</span>
    <a data-custom-website-link>{t.visit}<ArrowRight size={14} aria-hidden="true" /></a>
    <div class="custom-website-banner-actions">
      <button type="button" data-custom-website-never>{t.never}</button>
      <button type="button" data-custom-website-close aria-label={t.close} title={t.close}><X size={16} aria-hidden="true" /></button>
    </div>
  </div>
</aside>
<script>
  import { initGuide } from '../scripts/welcome-guide';
  void initGuide();
  window.addEventListener('pageshow', event => { if (event.persisted) void initGuide(); });
</script>
<style>
  .custom-website-banner { background: var(--blue-soft); border-bottom: 1px solid var(--accent-border); color: var(--ink); }
  .custom-website-banner-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    padding-block: 5px;
    font-size: var(--text-small);
  }
  .custom-website-banner-content a { display: inline-flex; gap: 4px; align-items: center; color: var(--blue); font-weight: 650; }
  .custom-website-banner-actions { display: flex; align-items: center; gap: 4px; margin-inline-start: auto; }
  .custom-website-banner-actions button {
    display: inline-grid;
    place-items: center;
    min-width: 32px;
    min-height: 32px;
    padding: 4px 6px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .custom-website-banner-actions button:hover { background: var(--surface); color: var(--ink); }
  .custom-website-banner-actions [data-custom-website-close] { min-width: 36px; }
</style>
