---
import { installationBridgeCopy as t } from '../lib/installation-bridge-copy';
---
<div class="installation-bridge" data-installation-bridge>
  <p class="bridge-label" data-bridge-label>{t.connectingGuide}</p>
  <div class="bridge-controls"><button type="button" class="button button-primary" disabled data-bridge-install>{t.enable}</button></div>
  <p class="bridge-status" role="status" aria-live="polite" data-bridge-status></p>
</div>
<script>import '../scripts/installation-bridge';</script>
<style>
  .installation-bridge { display: flex; flex-direction: column; gap: 10px; }
  .installation-bridge p { margin: 0; font-size: 13px; line-height: 1.6; }
  .bridge-label { color: var(--ink); font-weight: 600; }
  .bridge-status { color: var(--muted); }
  .bridge-controls .button { min-height: 32px; padding: 6px 12px; font-size: 13px; }
  .installation-bridge [hidden] { display: none; }
</style>
