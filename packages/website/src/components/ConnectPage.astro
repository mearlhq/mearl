---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallationBridge from './InstallationBridge.astro';
import { installationBridgeCopy } from '../lib/installation-bridge-copy';
import type { Locale } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = installationBridgeCopy[locale];
---
<BaseLayout title={`Mearl · ${t.title}`} description={t.lead} {locale} page="connect">
  <div class="page-frame">
    <section class="detail-hero">
      <p class="eyebrow">MEARL SETUP</p>
      <h1>{t.title}</h1>
      <p class="hero-lead">{t.lead}</p>
      <div class="connect-card"><InstallationBridge {locale} /></div>
    </section>
  </div>
</BaseLayout>
<style>.connect-card { max-width: 560px; margin-top: 24px; padding: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; } h1 { font-size: clamp(24px,4vw,40px); letter-spacing: -.04em; }</style>
