<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>城市漫步 · Mearl H5 示例</title>
  <style>
    * { box-sizing: border-box; }
    :root { color-scheme: light; font: 16px/1.5 system-ui, sans-serif; color: #182d29; background: #f8f7ef; }
    body { margin: 0; }
    header, main { max-width: 460px; margin: auto; padding-inline: 24px; }
    header { display: flex; justify-content: space-between; gap: 8px; padding-block: 16px; border-bottom: 1px solid #d7dfd4; }
    header small { color: #48605a; }
    main { padding-block: 28px; }
    h1 { margin: 0 0 4px; font-size: 2rem; line-height: 1.2; }
    p { margin: 0; color: #48605a; }
    section { margin-top: 24px; padding: 16px; background: #e5eee5; border-radius: 10px; }
    h2 { margin: 0 0 4px; font-size: 1rem; }
    button { margin-top: 12px; padding: 8px 12px; border: 0; border-radius: 6px; color: white; background: #245747; font: inherit; cursor: pointer; }
    button:focus-visible { outline: 2px solid #182d29; outline-offset: 3px; }
    #result { margin-top: 8px; color: #245747; font-weight: 650; }
    footer { margin-top: 20px; color: #48605a; font-size: .8rem; }
  </style>
</head>
<body>
  <header><strong id="brand">城市漫步</strong><small id="demo-label">H5 示例</small></header>
  <main>
    <h1 id="title">周六沿江漫步</h1>
    <p id="time">周六 · 10:00 · 3 公里</p>
    <section>
      <h2 id="entry">活动详情</h2>
      <p id="description">在南门集合，沿江步道出发。</p>
      <button id="check" type="button" hidden>检查微信桥接</button>
      <p id="result" role="status" hidden></p>
    </section>
    <footer id="context"></footer>
  </main>
  <script is:inline>
    const zh = new URLSearchParams(location.search).get('lang') !== 'en';
    const wechat = /MicroMessenger/i.test(navigator.userAgent);
    const strings = zh ? {
      brand: '城市漫步', 'demo-label': 'H5 示例', title: '周六沿江漫步',
      time: '周六 · 10:00 · 3 公里', entry: '活动详情',
      description: '在南门集合，沿江步道出发。',
      check: '检查微信桥接', context: wechat ? '当前环境 · 微信 WebView' : '当前环境 · 普通浏览器',
      ready: 'JSBridge 就绪', unavailable: 'JSBridge 暂不可用',
    } : {
      brand: 'City walks', 'demo-label': 'H5 demo', title: 'Saturday riverside walk',
      time: 'Saturday · 10:00 · 3 km', entry: 'Activity details',
      description: 'Meet at the south entrance and follow the riverside path.',
      check: 'Check the WeChat bridge', context: wechat ? 'Environment · WeChat WebView' : 'Environment · regular browser',
      ready: 'JSBridge ready', unavailable: 'JSBridge unavailable',
    };
    document.documentElement.lang = zh ? 'zh-CN' : 'en';
    document.title = strings.title;
    for (const id of ['brand', 'demo-label', 'title', 'time', 'entry', 'description', 'check', 'context']) {
      document.getElementById(id).textContent = strings[id];
    }
    const check = document.getElementById('check');
    check.hidden = !wechat;
    check.addEventListener('click', () => {
      const result = document.getElementById('result');
      result.hidden = false;
      result.textContent = strings.unavailable;
      if (typeof window.wx?.ready === 'function') {
        window.wx.ready(() => { result.textContent = strings.ready; });
      } else if (window.WeixinJSBridge) {
        result.textContent = strings.ready;
      }
    });
  </script>
</body>
</html>
