{
  "name": "@mearl/extension",
  "version": "3.1.0",
  "private": true,
  "description": "Agent 驱动的浏览器工具（Chrome 扩展）：自动化验证、调试观测、一键 Mock",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.chrome.ts",
    "package": "pnpm build && node scripts/package.js",
    "dev": "nodemon --config nodemon.chrome.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "i18n:check": "node scripts/clean-i18n.js",
    "i18n:clean": "node scripts/clean-i18n.js --remove"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "htm": "3.1.1",
    "lucide-react": "0.562.0",
    "preact": "10.29.0",
    "prismjs": "1.30.0",
    "uqr": "0.1.2",
    "webextension-polyfill": "0.12.0",
    "@mearl/plugin-tracking": "workspace:*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.5.0",
    "@mearl/app-profiles": "workspace:*",
    "@mearl/browser-core": "workspace:*",
    "@preact/preset-vite": "2.10.5",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/adm-zip": "0.5.7",
    "@types/chrome": "0.0.280",
    "@types/dom-chromium-ai": "0.0.14",
    "@types/node": "24.10.9",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/webextension-polyfill": "0.12.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/ui": "4.1.12",
    "adm-zip": "0.6.1",
    "fake-indexeddb": "6.2.6",
    "fs-extra": "11.3.3",
    "happy-dom": "21.0.4",
    "nodemon": "3.1.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "@mearl/preset": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mearlhq/mearl.git",
    "directory": "packages/extension"
  }
}
