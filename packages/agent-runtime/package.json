{
  "name": "@mearl/agent-runtime",
  "version": "3.1.0",
  "description": "Shared local agent provider runtimes for Mearl",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "import": "./dist/codex.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    }
  },
  "files": [
    "README.en.md",
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@mearl/daemon-core": "workspace:*",
    "@mearl/browser-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mearlhq/mearl.git",
    "directory": "packages/agent-runtime"
  }
}
